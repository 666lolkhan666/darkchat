rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == '5Uc5gT6JclWsAE6fLouHV8TRsVe2';
    }

    function validMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'text', 'createdAt', 'threadId', 'sender'])
        && data.keys().hasOnly(['name', 'text', 'createdAt', 'threadId', 'sender'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.createdAt == request.time
        && data.threadId is string
        && data.threadId.size() > 0
        && data.threadId.size() <= 128
        && (
          (
            data.sender == 'user'
            && request.auth != null
            && request.auth.uid != '5Uc5gT6JclWsAE6fLouHV8TRsVe2'
            && data.threadId == request.auth.uid
          )
          || (data.sender == 'owner' && isOwner())
        );
    }

    match /messages/{messageId} {
      allow read: if isOwner()
        || (request.auth != null && resource.data.threadId == request.auth.uid);
      allow create: if validMessage();
      allow update, delete: if false;
    }
  }
}
