rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == '5Uc5gT6JclWsAE6fLouHV8TRsVe2';
    }

    match /attachments/{threadId}/{fileId} {
      allow read: if isOwner()
        || (request.auth != null && request.auth.uid == threadId);
      allow create: if request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 268435456
        && request.auth != null
        && (
          (request.auth.uid == threadId && !isOwner())
          || isOwner()
        );
      allow delete: if isOwner()
        || (request.auth != null && request.auth.uid == threadId);
      allow update: if false;
    }
  }
}
